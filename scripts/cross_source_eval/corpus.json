      "required_sources": [
        "nano-claw-code"
      ],
      "min_citation_presence": 0.2
    },
    {
      "id": "code-002-request-path",
      "group": "code",
      "question": "Explain the request path from input to answer.",
      "scope": [
        "nano-claw-code"
      ],
      "expected_route": "fast",
      "anchors": [
        {
          "id": "api-handler",
          "rule": "all",
          "matches": [
            {
              "field": "source_ref",
              "contains": "src/api/server.ts"
            },
            {
              "field": "text",
              "contains": "handleChat"
            }
          ]
        }
      ],
      "required_sources": [
        "nano-claw-code"
      ],
      "min_citation_presence": 0.2,
      "known_failure": "The current plain-text code corpus has no call graph, so a broad request-path query can retrieve the loop without retrieving the handleChat entry symbol in the same top-k."
    },
    {
      "id": "code-003-retrieval-call",

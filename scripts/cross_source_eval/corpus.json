        "riff-design"
      ],
      "expected_route": "fast",
      "anchors": [
        {
          "id": "phase-one",
          "rule": "any",
          "matches": [
            {
              "field": "text",
              "contains": "Phase 1 thin slice"
            },
            {
              "field": "text",
              "contains": "exact/FTS/vector retrieval"
            },
            {
              "field": "text",
              "contains": "Flash default"
            }
          ]
        }
      ],
      "required_sources": [
        "riff-design"
      ],
      "min_citation_presence": 0.25
    },
    {
      "id": "document-005-open-decisions",
      "group": "document",
      "question": "Which implementation choices are still open in the design?",
      "scope": [
        "riff-design"
      ],
      "expected_route": "fast",
      "anchors": [
        {
          "id": "open-decisions",
          "rule": "any",
          "matches": [
            {
              "field": "text",
              "contains": "Open Decisions"
            },
            {
              "field": "text",
              "contains": "deployment target"
            },
            {
              "field": "text",
              "contains": "supported languages"
            }
          ]
        }
      ],
      "required_sources": [
        "riff-design"
      ],

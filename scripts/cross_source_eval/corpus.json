    {
      "id": "code-001-request-routing",
      "group": "code",
      "question": "Where is request routing implemented?",
      "scope": [
        "nano-claw-code"
      ],
      "expected_route": "fast",
      "anchors": [
        {
          "id": "routing-file",
          "rule": "any",
          "matches": [
            {
              "field": "source_ref",
              "contains": "src/api/server.ts"
            },
            {
              "field": "source_ref",
              "contains": "src/agent/deep-reasoning.ts"
            }
          ]
        },
        {
          "id": "routing-symbol",
          "rule": "any",
          "matches": [
            {
              "field": "text",
              "contains": "detectDeepQuestion"
            },
            {
              "field": "text",
              "contains": "stepLoop"

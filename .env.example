# ============================================================================
#  nano-claw / Space Channel voice console — ENVIRONMENT TEMPLATE
# ============================================================================
#
#  ┌──────────────────────────────────────────────────────────────────────┐
#  │  THIS IS A TEMPLATE. It contains FAKE placeholder values.              │
#  │                                                                        │
#  │  Setup:   cp .env.example .env    then fill in your REAL values.       │
#  │                                                                        │
#  │  NEVER commit .env — it holds live secrets and is gitignored.          │
#  │  NEVER put a real key in THIS file (.env.example is committed).        │
#  │                                                                        │
#  │  FOR AI AGENTS: do not paste real credentials here. Real values go     │
#  │  only in .env (gitignored). Leave every value below as a placeholder.  │
#  │  If a real secret ever lands in a committed file, treat it as leaked   │
#  │  and rotate it at the provider.                                        │
#  └──────────────────────────────────────────────────────────────────────┘

# ── LLM providers ───────────────────────────────────────────────────────────
# At minimum you need ANTHROPIC_API_KEY (the default conversation + scheduler
# model is Claude Haiku). The others enable extra models in the dropdowns; omit
# any you don't use — the app degrades gracefully (that provider's models just
# won't appear).
ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-YOUR-ANTHROPIC-KEY
GEMINI_API_KEY=REPLACE-WITH-YOUR-GEMINI-KEY
XAI_API_KEY=xai-REPLACE-WITH-YOUR-XAI-KEY
DEEPSEEK_API_KEY=sk-REPLACE-WITH-YOUR-DEEPSEEK-KEY
GROQ_API_KEY=gsk_REPLACE-WITH-YOUR-GROQ-KEY
OPENROUTER_API_KEY=sk-or-REPLACE-WITH-YOUR-OPENROUTER-KEY

# Scheduler (goal-region supervisor) model. Default is Claude Haiku 4.5.
# Examples: claude-haiku-4-5 | deepseek/deepseek-v4-flash | groq/openai/gpt-oss-20b
SCHED_EVAL_MODEL=claude-haiku-4-5

# Lawyer Scheduler live-calendar binding. Use a dedicated TEST calendar shared
# with the existing service account; see docs/design/appointment-booking-live-calendar.md.
# The JSON value is a HOST path. run.sh mounts it read-only at the container path.
NANO_CLAW_GCAL_CALENDAR_ID=REPLACE-WITH-TEST-CALENDAR-ID@group.calendar.google.com
NANO_CLAW_GCAL_SERVICE_ACCOUNT_JSON=/absolute/host/path/to/gcal-service-account.json

# ── Phone line (Telnyx) — optional; only if you run the phone node ───────────
NANO_CLAW_PHONE=0                          # 1 to enable the Telnyx phone gateway
TELNYX_API_KEY=KEY-REPLACE-WITH-YOUR-TELNYX-KEY
NANO_CLAW_PHONE_WEBHOOK_BASE=https://your-tunnel-host.example.com
NANO_CLAW_PHONE_TOKEN=REPLACE-WITH-A-RANDOM-WEBHOOK-SHARED-SECRET
NANO_CLAW_PHONE_CODEC=l16                  # l16 (HD) | pcmu (8kHz)
NANO_CLAW_PHONE_VAD=energy                 # energy | silero
NANO_CLAW_PHONE_STT_SIZE=base              # tiny | base | small | medium
NANO_CLAW_PHONE_STT_STREAM=0               # 1 = transcribe while caller speaks (dark rollout)
NANO_CLAW_PHONE_VOICE=af_heart
NANO_CLAW_PHONE_BARGE_IN=1
NANO_CLAW_PHONE_BARGE_VAD_ENTER=0.7        # raw Silero barge threshold (0.5-0.95)
NANO_CLAW_PHONE_BARGE_TRIGGER_MS=350       # sustained vote required (120-1500 ms)
NANO_CLAW_PHONE_ECHO_GATE=1                # suppress correlated outbound speaker echo
NANO_CLAW_PHONE_ECHO_CORR=0.75             # normalized echo threshold (0-1)
NANO_CLAW_PHONE_DYNAMIC_ENDPOINT=1

# ── Call review panel (/calls) — recording, disclosure, retention ────────────
# Dedicated credential for /api/calls, per-call recordings, /api/metrics,
# and /api/costs. Generate a different random value from the Telnyx phone
# token above. Send it only as X-NC-Operator-Read; never put it in a URL.
NANO_CLAW_OPERATOR_READ_TOKEN=REPLACE-WITH-A-DIFFERENT-RANDOM-OPERATOR-READ-SECRET
# Recording is ON by default (audio taps + transcript timeline feed /calls).
# NANO_CLAW_PHONE_TAP=0 disables audio capture; tap files land in
# NANO_CLAW_PHONE_TAP_DIR (default /app/data/phone-taps, inside the data
# volume so recordings survive rebuilds).
# NANO_CLAW_PHONE_RECORD_NOTICE overrides the disclosure appended to the
# greeting; set to `off` to keep the plain greeting (recording stays on).
# NANO_CLAW_CALL_RETENTION_DAYS sweeps transcripts + audio older than N days
# (0/empty disables; call metadata in phone_calls is always kept).
#NANO_CLAW_PHONE_TAP=1
#NANO_CLAW_PHONE_RECORD_NOTICE=This call may be recorded for quality and training.
NANO_CLAW_CALL_RETENTION_DAYS=30
# Shown as a "Call the line" banner on the voice console; keep in sync with
# whichever DID's Telnyx webhook points at this node (see /phone-routing).
#NANO_CLAW_PHONE_DISPLAY_NUMBER=512-277-7311

# ── Google sign-in — optional; only if you enable per-user history ───────────
# The Client ID is PUBLIC (it ships in the page) — no client secret is used.
# Create it in Google Cloud Console → Credentials → OAuth client ID (Web app);
# add http://localhost:9090 and your tunnel host as Authorized JS origins.
NANO_CLAW_GOOGLE_CLIENT_ID=REPLACE-WITH-YOUR-CLIENT-ID.apps.googleusercontent.com
NANO_CLAW_AUTH=optional                    # optional | off  (no login button when off)
NANO_CLAW_PUBLIC_HTTPS=1                    # deployed console terminates HTTPS at the tunnel;
                                           # localhost HTTP remains a cookie-policy exception

# ── Console flags ────────────────────────────────────────────────────────────
NANO_CLAW_VOICE_FLOW=scheduler             # boot-default browser flow
NANO_CLAW_BARGE_IN=1                       # expose control; per-browser preference defaults off
NANO_CLAW_MEMORY_DIR=/app/data/memory      # conversation + analysis sidecars on persistent volume
NANO_CLAW_SENTENCE_GAP_MS=240              # silence appended after . ! ? (0-1000 ms)
NANO_CLAW_SPEECH_PREPARATION=1             # prepared natural speech; 0 is the raw A/B rollback
NANO_CLAW_SPEECH_MAX_WORDS=18              # semantic target; never forces arbitrary word cuts
NANO_CLAW_SPEECH_MAX_CHUNK_MS=2500         # estimated maximum prepared chunk duration
NANO_CLAW_PHONE_SPEECH_PREPARATION=1       # 1 = streaming prepared speech (compile per sentence as the LLM writes); batch = compile only after the full reply; raw = no compiler
# WARNING: setting this to true grants the anonymous public socket shell access
# inside a root container. Leave it false unless that exposure is intentional.
NANO_CLAW_ENABLE_TOOLS=false
# Shared operator password guarding the console's deployment-wide config
# writes (POST /api/phone/config, /api/phone/vad, /api/voice/flow,
# /api/voice/region-model). These change behaviour for EVERY caller, so they
# are refused when this is unset. Reads (GET) stay open. Never commit a real
# value; the Telnyx webhook /api/phone/incoming is deliberately NOT covered.
NANO_CLAW_OPERATOR_PASSWORD=change-me
NANO_CLAW_ANALYSIS_STYLE=topic_map            # topic_map | principle_graph (experimental)
